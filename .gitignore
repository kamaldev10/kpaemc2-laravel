# ==============================================================================
# Git Ignore — KPA EMC² Web Portal
# ==============================================================================

# --- Environment & Credentials ---
.env
.env.backup
.env.production
.env.staging
.env.testing
/auth.json
*.pem
*.key

# --- Dependencies ---
/node_modules
/vendor

# --- Build & Runtime Artifacts ---
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/bootstrap/ssr
dist/

# --- Storage & Application Cache ---
/storage/*.key
/storage/pail
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/.gitignore

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Code Quality Caches ---
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
.phpactor.json
.eslintcache
.stylelintcache
coverage/

# --- IDE & Editor Specific ---
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

/.idea
/.vscode
/.nova
/.zed
/.codex

# --- AI Agent Local Backups & Scratch ---
/.agents/backups/
/scratch/

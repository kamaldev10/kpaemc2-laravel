        "@types/node": "^22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
